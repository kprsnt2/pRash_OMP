# ==============================================================================
# OmniChat Environment Configuration
# Add these in your Vercel Project Settings > Environment Variables
# or in Cloudflare Pages / Workers environment variables.
# ==============================================================================

# 1. OpenAI (Default ChatGPT: gpt-5.4-mini or gpt-5.4-nano)
OPENAI_API_KEY=

# 2. Google Gemini (Backup 1 & Zero-Retention Paid Privacy Key)
# Accepts either GEMINI_API_KEY or GOOGLE_AI_API_KEY
GEMINI_API_KEY=

# 3. NVIDIA NIM (Backup 2: meta/llama-3.3-70b-instruct)
NVIDIA_API_KEY=

# 4. Groq LPU (Backup 3: llama-3.3-70b-versatile)
GROQ_API_KEY=
